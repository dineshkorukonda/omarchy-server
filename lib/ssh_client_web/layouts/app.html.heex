<main class="h-full">
  <%= if msg = Phoenix.Flash.get(@flash, :info) do %>
    <p class="fixed top-4 right-4 z-50 px-4 py-2 bg-blue-600 text-white text-sm rounded-lg shadow-lg" role="alert"><%= msg %></p>
  <% end %>
  <%= if msg = Phoenix.Flash.get(@flash, :error) do %>
    <p class="fixed top-4 right-4 z-50 px-4 py-2 bg-red-600 text-white text-sm rounded-lg shadow-lg" role="alert"><%= msg %></p>
  <% end %>
  {@inner_content}
</main>
